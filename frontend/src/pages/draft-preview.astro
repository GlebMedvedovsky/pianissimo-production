---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Portfolio from '../components/Portfolio.astro';
import MusicLibrary from '../components/MusicLibrary.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import PlainText from '../components/PlainText.astro';
import Icon from '../components/Icon.astro';
import {contentFor} from '../lib/content/data';

export const prerender=false;

const content=contentFor(Astro.locals);
const route=Astro.url.searchParams.get('route')||'/';
const projectSlug=route.match(/^\/projects\/([a-z0-9]+(?:-[a-z0-9]+)*)\/?$/)?.[1];
const project=projectSlug?content.projects.find(item=>item.slug===projectSlug):undefined;
const known=['/','/film-music/','/directing/','/legal/','/privacy/'].includes(route)||!!project;
if(!known)Astro.response.status=404;
let section:'home'|'music'|'directing'|'project'|'legal'='legal';
let title:string|undefined=known?undefined:'Preview not found';
let theme:'dark'|'light'='dark';
if(route==='/'){section='home';}
else if(route==='/film-music/'){section='music';title='Film Music';}
else if(route==='/directing/'){section='directing';title='Directing';theme='light';}
else if(route==='/legal/'){title='Legal notice';}
else if(route==='/privacy/'){title='Privacy policy';}
else if(project){section='project';title=project.title;}
---
<Base title={title} section={section} theme={theme} description={project?.synopsis} content={content}>
 {route==='/'&&<Hero content={content}/>}
 {route==='/film-music/'&&<><Portfolio section="music" content={content}/><MusicLibrary content={content}/><div class="about-invitation"><p class="eyebrow">THE PERSON BEHIND THE WORK</p><a href="/#about" data-about>Meet Sebastian <span class="about-invitation-icon"><Icon name="arrowUpRight" size={40}/></span></a></div></>}
 {route==='/directing/'&&<><Portfolio section="directing" content={content}/><div class="about-invitation"><p class="eyebrow">THE PERSON BEHIND THE WORK</p><a href="/#about" data-about>Meet Sebastian <span class="about-invitation-icon"><Icon name="arrowUpRight" size={40}/></span></a></div></>}
 {route==='/legal/'&&<article class="legal-page"><p class="eyebrow">LEGAL INFORMATION</p><h1>Legal <em>notice.</em></h1><PlainText text={content.site.legal.notice}/></article>}
 {route==='/privacy/'&&<article class="legal-page"><p class="eyebrow">PRIVACY INFORMATION</p><h1>Your <em>privacy.</em></h1><PlainText text={content.site.legal.privacy}/><button class="text-link" data-consent-settings>Open media settings ↗</button></article>}
 {project&&<div class="direct-project"><a class="text-link" href="/film-music/">← Film Music</a>{project.memberships.directing&&<a class="text-link" href="/directing/">Directing →</a>}<ProjectDetail project={project} content={content}/></div>}
 {!known&&<article class="legal-page"><h1>Preview not found.</h1><p>This page is not part of the saved draft.</p></article>}
</Base>
