---
import Icon from './Icon.astro';
---
<div id="media-root" transition:persist="media-root">
 <audio id="shared-audio" preload="none"></audio>
 <section class="player" aria-label="Audio player" hidden>
  <div class="player-track"><img data-player-cover width="52" height="52" alt="" hidden/><div><strong data-player-title></strong><span data-player-subtitle></span></div></div>
  <div class="player-buttons"><button data-player="previous" class="icon-button track-only" aria-label="Previous track"><Icon name="previous"/></button><button data-player="toggle" class="icon-button play-button" aria-label="Play"><span data-play-icon><Icon name="play"/></span><span data-pause-icon hidden><Icon name="pause"/></span></button><button data-player="next" class="icon-button track-only" aria-label="Next track"><Icon name="next"/></button><button data-player="shuffle" class="icon-button track-only" aria-label="Shuffle" aria-pressed="false"><Icon name="shuffle"/></button></div>
  <div class="player-progress"><span data-player-time>0:00</span><input type="range" min="0" max="100" step="0.1" value="0" data-player-seek aria-label="Seek audio"/><span data-player-duration>—</span></div>
  <div class="player-more"><button data-player="mute" class="icon-button" aria-label="Mute audio" aria-pressed="false"><span data-sound-icon><Icon name="sound"/></span><span data-sound-off-icon hidden><Icon name="soundOff"/></span></button><label class="volume-label">Volume<input type="range" min="0" max="1" step="0.01" value="0.65" data-player-volume aria-label="Volume"/></label><a href="/film-music/" data-player-project class="icon-button track-only" aria-label="Current project details"><Icon name="info"/></a><span data-player-platforms class="player-platforms track-only" hidden></span><button data-player="close" class="icon-button" aria-label="Close player"><Icon name="close"/></button></div>
  <button data-player="more" class="player-more-trigger" aria-label="More player controls" aria-controls="player-secondary-controls" aria-expanded="false">More <Icon name="down" size={16}/></button>
  <div id="player-secondary-controls" class="player-secondary" aria-label="Additional player controls" hidden>
   <div class="player-secondary-transport track-only"><button data-player="previous" class="icon-button" aria-label="Previous track"><Icon name="previous"/></button><button data-player="next" class="icon-button" aria-label="Next track"><Icon name="next"/></button><button data-player="shuffle" class="icon-button" aria-label="Shuffle" aria-pressed="false"><Icon name="shuffle"/></button></div>
   <button data-player="mute" class="icon-button" aria-label="Mute audio" aria-pressed="false"><span data-sound-icon><Icon name="sound"/></span><span data-sound-off-icon hidden><Icon name="soundOff"/></span></button><label class="volume-label">Volume<input type="range" min="0" max="1" step="0.01" value="0.65" data-player-volume aria-label="Volume"/></label><a href="/film-music/" data-player-project class="icon-button track-only" aria-label="Current project details"><Icon name="info"/></a><span data-player-platforms class="player-platforms track-only" hidden></span>
  </div>
  <p class="player-error" role="status" hidden></p>
 </section>
</div>

