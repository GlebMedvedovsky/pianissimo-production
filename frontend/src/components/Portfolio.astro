---
import {musicCategories} from '../../../contracts/content';import {content,asset} from '../lib/content/data';import {selectProjects} from '../lib/content/selectors';import {siteConfig} from '../config/site.config';import Icon from './Icon.astro';
interface Props {section:'music'|'directing'}
const {section}=Astro.props;const isMusic=section==='music';const projects=selectProjects(content,section,'All');const filters=isMusic?['All',...musicCategories]:['Director','Assistant Director'];const defaultFilter=isMusic?'All':siteConfig.directing.defaultFilter;
---
<section class:list={['portfolio',section]} data-portfolio={section} data-default-filter={defaultFilter} aria-labelledby="portfolio-title">
 <div class="portfolio-intro"><p class="eyebrow">{isMusic?'COMPOSER’S WORK':'DIRECTOR’S WORK'} <span>SELECTED PROJECTS</span></p><div class="portfolio-title-row"><h1 id="portfolio-title">{isMusic?'Film':'Directing'}{isMusic&&<em> Music.</em>}{!isMusic&&<em>.</em>}</h1></div></div>
 <div class="filter-bar" role="group" aria-label="Filter projects">{filters.map(f=><button data-project-filter={f} aria-pressed={f===defaultFilter}>{f}</button>)}<span class="project-count" aria-live="polite">{projects.length} projects</span></div>
 <div class="project-grid">{projects.map((project,i)=>{const member=project.memberships[section]!;const cover=asset(member.coverAssetId)!;return <a href={`/projects/${project.slug}/`} data-project={project.id} data-project-card data-categories={project.categories.join('|')} data-role={member.role} class="project-card" style={`--card-order:${i}`}><div class="card-image"><img src={'/'+cover.path} srcset={`/${cover.path.replace('.webp','-480.webp')} 480w, /${cover.path} ${cover.width}w`} sizes={isMusic?'(max-width: 600px) 90vw, (max-width: 1000px) 43vw, 28vw':'(max-width: 700px) 90vw, 43vw'} width={cover.width} height={cover.height} loading={i<3?'eager':'lazy'} alt={cover.alt} style={`object-fit:cover;object-position:${member.crop.x}% ${member.crop.y}%`}/>{member.hoverAssetId&&<video data-hover-video data-src={'/'+asset(member.hoverAssetId)!.path} muted playsinline loop preload="none" aria-hidden="true" style={`object-position:${member.crop.x}% ${member.crop.y}%`}/>}<span class="card-overlay"><span>EXPLORE PROJECT</span><Icon name="arrow" size={28}/></span></div><div class="card-caption"><h2>{project.title}</h2><span>{[project.productionType,project.year,project.presentationStatus==='placeholder'?'Temporary cover':null].filter(Boolean).join(' · ')}</span></div></a>})}</div>
 <p class="empty-state portfolio-empty" hidden role="status">No confirmed projects in this category yet. Please explore another selection.</p>
 <a class:list={['section-switch',{'switch-left':!isMusic}]} href={isMusic?'/directing/':'/film-music/'} data-direction={isMusic?'right':'left'}><span>{isMusic?'DISCOVER THE OTHER SIDE':'THE OTHER SIDE OF THE STORY'}</span><strong>{isMusic?'Directing →':'← Film Music'}</strong></a>
</section>
