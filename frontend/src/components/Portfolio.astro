---
import { musicCategories } from '../../../contracts/content';
import { content, asset } from '../lib/content/data';
import { selectProjects } from '../lib/content/selectors';
import { siteConfig } from '../config/site.config';
import Icon from './Icon.astro';

interface Props {
  section: 'music' | 'directing';
}

const { section } = Astro.props;
const isMusic = section === 'music';
const projects = selectProjects(content, section, 'All');
const filters = isMusic
  ? ['All', ...musicCategories]
  : ['Director', 'Assistant Director'];
const defaultFilter = isMusic ? 'All' : siteConfig.directing.defaultFilter;

const SVG_W = 70;
const SVG_H = 900;
const MASTER_PATH = `  M 0,900
  L 0,38
  C 0,13 11,0 28,0
  C 42,0 48,15 48,38
  C 48,150 46,255 44,370
  C 43,445 49,490 59,540
  C 67,575 68,650 68,800
  L 68,900
  Z`.replace(/\s+/g, ' ').trim();

const sectionSwitchTransform = isMusic
  ? `translate(${SVG_W} 0) scale(-1 1)`
  : undefined;
const keyboardClipId = `section-switch-keyboard-clip-${section}`;
const whiteKeys = [-12, -2, 8, 18, 28, 38, 48, 58];
const blackKeyBoundaries = [-2, 8, 28, 38, 48, 68];
---

<section
  class:list={['portfolio', section]}
  data-portfolio={section}
  data-default-filter={defaultFilter}
  aria-labelledby="portfolio-title"
>
  <div class="portfolio-intro">
    <p class="eyebrow">
      {isMusic ? 'COMPOSER’S WORK' : 'DIRECTOR’S WORK'}
      <span>SELECTED PROJECTS</span>
    </p>
    <div class="portfolio-title-row">
      <h1 id="portfolio-title">
        {isMusic ? 'Film' : 'Directing'}
        {isMusic && <em> Music.</em>}
        {!isMusic && <em>.</em>}
      </h1>
    </div>
  </div>

  <div class="filter-bar" role="group" aria-label="Filter projects">
    {
      filters.map((filter) => (
        <button
          data-project-filter={filter}
          aria-pressed={filter === defaultFilter}
        >
          {filter}
        </button>
      ))
    }
    <span class="project-count" aria-live="polite">
      {projects.length} projects
    </span>
  </div>

  <div class="project-grid">
    {
      projects.map((project, index) => {
        const member = project.memberships[section]!;
        const cover = asset(member.coverAssetId)!;

        return (
          <a
            href={`/projects/${project.slug}/`}
            data-project={project.id}
            data-project-card
            data-categories={project.categories.join('|')}
            data-role={member.role}
            class="project-card"
            style={`--card-order:${index}`}
          >
            <div class="card-image">
              <img
                src={'/' + cover.path}
                srcset={`/${cover.path.replace('.webp', '-480.webp')} 480w, /${cover.path} ${cover.width}w`}
                sizes={
                  isMusic
                    ? '(max-width: 600px) 90vw, (max-width: 1000px) 43vw, 28vw'
                    : '(max-width: 700px) 90vw, 43vw'
                }
                width={cover.width}
                height={cover.height}
                loading={index < 3 ? 'eager' : 'lazy'}
                alt={cover.alt}
                style={`object-fit:cover;object-position:${member.crop.x}% ${member.crop.y}%`}
              />
              {
                member.hoverAssetId && (
                  <video
                    data-hover-video
                    data-src={'/' + asset(member.hoverAssetId)!.path}
                    muted
                    playsinline
                    loop
                    preload="none"
                    aria-hidden="true"
                    style={`object-position:${member.crop.x}% ${member.crop.y}%`}
                  />
                )
              }
              <span class="card-overlay">
                <span>EXPLORE PROJECT</span>
                <Icon name="arrow" size={28} />
              </span>
            </div>
            <div class="card-caption">
              <h2>{project.title}</h2>
              <span>
                {
                  [
                    project.productionType,
                    project.year,
                    project.presentationStatus === 'placeholder'
                      ? 'Temporary cover'
                      : null,
                  ]
                    .filter(Boolean)
                    .join(' · ')
                }
              </span>
            </div>
          </a>
        );
      })
    }
  </div>

  <p class="empty-state portfolio-empty" hidden role="status">
    No confirmed projects in this category yet. Please explore another
    selection.
  </p>

  <a
    class:list={['section-switch', { 'switch-left': !isMusic }]}
    href={isMusic ? '/directing/' : '/film-music/'}
    data-direction={isMusic ? 'right' : 'left'}
    aria-label={isMusic ? 'Open Directing' : 'Open Film Music'}
  >
    <svg
      class="section-switch-shape"
      viewBox={`0 0 ${SVG_W} ${SVG_H}`}
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <clipPath id={keyboardClipId} clipPathUnits="userSpaceOnUse">
          <rect x="-20" y="848" width="88" height="40"></rect>
        </clipPath>
      </defs>
      <path
        class="section-switch-body"
        d={MASTER_PATH}
        transform={sectionSwitchTransform}
      ></path>
      <g
        class="section-switch-keys"
        transform={sectionSwitchTransform}
      >
        <g clip-path={`url(#${keyboardClipId})`}>
          {
            whiteKeys.map((x) => (
              <rect
                class="section-switch-white-key"
                x={x}
                y="848"
                width="10"
                height="40"
              ></rect>
            ))
          }
          {
            blackKeyBoundaries.map((boundary) => (
              <rect
                class="section-switch-black-key"
                x={boundary - 2.75}
                y="848"
                width="5.5"
                height="24"
              ></rect>
            ))
          }
        </g>
      </g>
    </svg>
    <span class="section-switch-copy">
      <span>
        {isMusic ? 'DISCOVER THE OTHER SIDE' : 'THE OTHER SIDE OF THE STORY'}
      </span>
      <strong>{isMusic ? 'Directing →' : '← Film Music'}</strong>
    </span>
  </a>
</section>
