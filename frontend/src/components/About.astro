---
import MediaSlot from './MediaSlot.astro';import Icon from './Icon.astro';import {content} from '../lib/content/data';
---
<section id="about" class="about-section" data-theme="dark" aria-labelledby="about-title">
 <div class="about-portrait"><MediaSlot name="about"/></div>
 <div class="about-content"><p class="eyebrow">THE PERSON BEHIND THE WORK</p><h2 id="about-title">Sebastian <em>Greim.</em></h2><p class="about-role">Composer. Filmmaker. Storyteller.</p>{content.site.biography.map(p=><p>{p}</p>)}<button class="text-link" data-contact>Get in touch <Icon name="arrow"/></button>
 <details class="cv" open><summary>Selected journey <span>{content.site.cv.length} milestones</span></summary><ol>{content.site.cv.map(item=><li><span class="cv-date">{item.date}</span><div>{item.link&&item.linkText&&item.text.includes(item.linkText)?<>{item.text.slice(0,item.text.indexOf(item.linkText))}<a href={item.link} target="_blank" rel="noreferrer">{item.linkText}</a>{item.text.slice(item.text.indexOf(item.linkText)+item.linkText.length)}</>:item.link?<a href={item.link} target="_blank" rel="noreferrer">{item.text}</a>:item.text}{item.status==='needs-confirmation'&&<small>Details awaiting confirmation</small>}</div></li>)}</ol></details>
 <div class="platform-links">{Object.entries(content.site.artistLinks||{}).map(([name,url])=><a href={url} target="_blank" rel="noreferrer">{name==='appleMusic'?'Apple Music':'Tidal'} artist ↗</a>)}</div>
 <a class="text-link back-menu" href="/#main-menu">Back to the main menu ↑</a></div>
</section>
