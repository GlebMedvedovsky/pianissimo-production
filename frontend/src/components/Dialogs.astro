---
import Icon from './Icon.astro';
import { content as activeContent } from '../lib/content/data';
import type { Manifest } from '../../../contracts/content';
import { siteConfig } from '../config/site.config';
interface Props {
  content?: Manifest
}
const { content = activeContent } = Astro.props;
const email = siteConfig.contacts.email || content.site.contacts.email;
const contactApiUrl = import.meta.env.PIANISSIMO_CONTACT_API_URL;
const consent = content.site.consent ?? {
  version: 1,
  necessary: true,
  externalMedia: true,
  analytics: false,
  marketing: false,
  bannerText: '',
  privacyLink: '/privacy/'
};
const analytics = content.site.analytics ?? {
  enabled: false,
  provider: 'none',
  measurementId: null,
  siteDomain: null
};
---
<dialog id="project-dialog" class="project-dialog" aria-label="Project details">
  <button class="dialog-close" data-close-project aria-label="Close project"><Icon name="close" /></button>
  <div id="project-dialog-content"></div>
  <div id="project-dialog-player-slot"></div>
</dialog>
<dialog id="contact-dialog" class="small-dialog" aria-labelledby="contact-title">
  <button class="dialog-close" data-close-dialog aria-label="Close contact dialog"><Icon name="close" /></button>
  <p class="eyebrow">LET’S MAKE SOMETHING MEANINGFUL</p>
  <h2 id="contact-title">Get in <em>touch.</em></h2>
  <p>Tell me about your film, scene, musical direction, collaboration idea, or another detailed question.</p>
  <form id="contact-form" data-contact-endpoint={contactApiUrl}>
    <label>Name<input name="name" autocomplete="name" required maxlength="120" /></label>
    <label>Email<input type="email" name="email" autocomplete="email" required maxlength="254" /></label>
    <label>Message<textarea name="message" rows="8" required minlength="10" maxlength="15000"></textarea></label>
    <div class="contact-honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <input type="hidden" name="started_at" value="" />
    <p class="contact-privacy">By sending this message, your details will be used only to respond to your inquiry. <a href={consent.privacyLink}>Read the privacy information.</a></p>
    <button type="submit" class="outline-button">Send message <Icon name="arrow" /></button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
  {email && <a class="text-link contact-email-fallback" href={`mailto:${email}`}>Email Sebastian directly ↗</a>}
</dialog>
<div data-consent-root data-consent-config={JSON.stringify(consent)} data-analytics-config={JSON.stringify(analytics)}>
  <dialog id="consent-dialog" class="small-dialog consent-dialog" aria-labelledby="consent-title">
    <button class="dialog-close" data-close-dialog aria-label="Close cookie settings"><Icon name="close" /></button>
    <p class="eyebrow">YOUR PRIVACY</p>
    <h2 id="consent-title">Cookie <em>settings.</em></h2>
    <p>Choose which optional services may load. Necessary website functions are always available.</p>
    <div class="consent-preferences">
      <label><input type="checkbox" checked disabled /> <span><strong>Necessary</strong><small>Required for the website and your saved privacy choice.</small></span></label>
      {consent.externalMedia && <label><input type="checkbox" data-consent-toggle="externalMedia" /> <span><strong>External media</strong><small>Allows a selected YouTube or Vimeo film to load.</small></span></label>}
      {consent.analytics && <label><input type="checkbox" data-consent-toggle="analytics" /> <span><strong>Analytics</strong><small>Allows the configured statistics provider to load.</small></span></label>}
      {consent.marketing && <label><input type="checkbox" data-consent-toggle="marketing" /> <span><strong>Marketing</strong><small>Allows configured marketing services. None are currently connected.</small></span></label>}
    </div>
    <p class="consent-status" role="status" aria-live="polite"></p>
    <div class="consent-actions">
      <button class="outline-button" data-consent="rejected">Necessary only</button>
      <button class="outline-button" data-consent="accepted">Accept all</button>
      <button class="outline-button" data-consent="save">Save settings</button>
    </div>
    <a href={consent.privacyLink}>Read the privacy information ↗</a>
  </dialog>
  <section class="cookie-notice" aria-labelledby="cookie-notice-title" hidden>
    <div><strong id="cookie-notice-title">Your privacy choices</strong><p>{consent.bannerText || 'We use necessary browser storage. Optional external media and statistics load only with your permission.'}</p></div>
    <div class="cookie-notice-actions"><button data-consent="rejected">Necessary only</button><button data-consent="accepted">Accept all</button><button data-consent-settings>Settings</button><a href={consent.privacyLink}>Privacy</a></div>
  </section>
</div>
