---
import Logo from './Logo.astro';import Icon from './Icon.astro';import {siteConfig} from '../config/site.config';import {content as activeContent} from '../lib/content/data';import type {Manifest} from '../../../contracts/content';
import {railHref,railIcon,resolveIconRail} from '../lib/iconRail';
interface Props {section?:string;content?:Manifest}
const {section,content=activeContent}=Astro.props;
const rail=resolveIconRail(content.site);
const railItems=rail.items.filter(item=>item.visible&&item.destination).sort((a,b)=>a.sort_order-b.sort_order);
---
<a class="skip-link" href="#content">Skip to content</a>
<header class:list={['site-header',{'site-header--portfolio':section==='music'||section==='directing'}]}>
 <a class="brand" href="/" aria-label="Pianissimo Production home" data-brand-home><Logo header/><span>PIANISSIMO<small>PRODUCTION</small></span></a>
 <nav aria-label="Main navigation"><a href="/film-music/" aria-current={section==='music'?'page':undefined} data-direction="left">{siteConfig.navigation.music}</a><a href="/directing/" aria-current={section==='directing'?'page':undefined} data-direction="right">{siteConfig.navigation.directing}</a><a href="/#about" data-about>{siteConfig.navigation.about}</a><button data-contact>{siteConfig.navigation.contact}</button></nav>
</header>
<aside class="social-rail" aria-label="Contact and social links" data-icon-style={rail.style}>
 {railItems.map(item=><a href={railHref(item)} target={item.type==='mail'?undefined:'_blank'} rel={item.type==='mail'?undefined:'noreferrer'} aria-label={item.label} title={item.label}><Icon name={railIcon[item.type]||'arrowUpRight'}/></a>)}
</aside>
