<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
><path
    d={name === 'next' ? paths.previous : paths[name] || paths.arrow}
    transform={name === 'next' ? 'translate(24 0) scale(-1 1)' : undefined}
  /></svg>
