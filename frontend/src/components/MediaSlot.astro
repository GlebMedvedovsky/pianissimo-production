---
import { content as activeContent, assetFrom } from '../lib/content/data';
import type { Manifest } from '../../../contracts/content';
interface Props {
  name: keyof Manifest['site']['mediaSlots'];
  eager?: boolean;
  class?: string;
  content?: Manifest
}
const { name, eager = false, class: className = '', content = activeContent } = Astro.props;
const slot = content.site.mediaSlots[name];
const picture = assetFrom(content, slot.image || slot.poster);
const videoPoster = assetFrom(content, slot.poster || slot.image);
const video = assetFrom(content, slot.video);
---
<div class:list={['media-slot', className]} data-slot={name}>
  {picture && <img
    src={'/' + picture.path}
    width={picture.width}
    height={picture.height}
    alt={name === 'about' ? picture.alt : ''}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    style={`object-position:${picture.crop.x}% ${picture.crop.y}%`}
  />}
  {video && <video
    transition:persist={name === 'hero' ? 'hero-showreel' : undefined}
    transition:persist-props={name === 'hero'}
    data-slot-video={name}
    src={'/' + video.path}
    poster={videoPoster ? '/' + videoPoster.path : undefined}
    muted
    playsinline
    loop
    preload="none"
    aria-label={name === 'hero' ? 'Showreel' : 'Silent background preview'}
  />}
  {picture?.credit && <span class="photo-credit">Photo: {picture.credit}</span>}
</div>
