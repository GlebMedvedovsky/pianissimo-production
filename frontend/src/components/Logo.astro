---
import {logoLeft as left,logoRight as right} from '../lib/navigation/logo-geometry';
interface Props {menu?:boolean; header?:boolean; class?:string}
const {menu=false,header=false,class:className=''}=Astro.props;
---
<svg class:list={['piano-mark',{'piano-mark-header':header},className]} viewBox="0 0 730 690" role={menu?undefined:'img'} aria-label={menu?undefined:'Pianissimo Production — reconstructed piano mark'}>
 {menu ? <g class="logo-composition">
  <g class="logo-half logo-half-black"><a href="/film-music/" class="logo-choice composer-choice" aria-label="Explore Film Music" data-direction="left"><path class="logo-left" d={left}/><g class="logo-label" aria-hidden="true"><text x="240" y="162" class="logo-eyebrow">COMPOSER’S WORK</text><text x="242" y="228" class="logo-title">Film Music</text><text x="240" y="277" class="logo-link">← EXPLORE</text></g></a></g>
  <g class="logo-half logo-half-cream"><a href="/directing/" class="logo-choice director-choice" aria-label="Explore Directing" data-direction="right"><path class="logo-right" d={right}/><g class="logo-label" aria-hidden="true"><text x="460" y="467" class="logo-eyebrow">DIRECTOR’S WORK</text><text x="460" y="533" class="logo-title">Directing</text><text x="460" y="582" class="logo-link">EXPLORE →</text></g></a></g>
 </g> : <><path class="logo-left" d={left}/><path class="logo-right" d={right}/></>}
</svg>
<style>
 .piano-mark-header path{stroke-width:1px;vector-effect:non-scaling-stroke}
 .piano-mark-header .logo-left{stroke:var(--muted)}
 :global(html[data-theme=light]) .piano-mark-header .logo-left{stroke:none}
 :global(html[data-theme=light]) .piano-mark-header .logo-right{stroke:var(--muted)}
</style>
