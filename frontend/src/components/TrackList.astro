---
import { content as activeContent, assetFrom } from '../lib/content/data';
import { projectForTrack, platformLinks, trackCoverAssetId } from '../lib/content/selectors';
import { formatTrackTime, normalizeWaveform } from '../lib/media/waveform-model';
import Icon from './Icon.astro';
import type { Track, Manifest } from '../../../contracts/content';
interface Props {
  tracks: Track[];
  compact?: boolean;
  content?: Manifest
}
const { tracks, compact = false, content = activeContent } = Astro.props;
---
<div class:list={['track-list', { compact }]}>
  {tracks.map((track, i) => {
    const project = projectForTrack(content, track.id);
    const cover = assetFrom(content, trackCoverAssetId(content, track));
    const platforms = project ? platformLinks(track, project) : track.platformOverrides;
    const peaks = normalizeWaveform(track.peaks);
    const waveformWidth = peaks ? peaks.length * 4 - 2 : 0;
    return <div class="track-row" data-track-row={track.id} data-genres={track.genres.join('|')} data-emotions={track.emotions.join('|')}>
      <span class="track-number">{String(i + 1).padStart(2, '0')}</span>
      <div class="track-summary">
        {track.audioAssetId ? <button class="track-cover-play" data-play-track={track.id} aria-label={`Play ${track.title}`}>
          {cover ? <img src={'/' + cover.path} width="48" height="48" loading="lazy" alt="" /> : <span class="track-cover-placeholder" aria-hidden="true">—</span>}
          <span class="track-cover-icon" aria-hidden="true"><span data-track-play-icon><Icon name="play" /></span><span data-track-pause-icon hidden><Icon name="pause" /></span></span>
        </button> : <span class="track-cover-play track-cover-play--static">{cover ? <img src={'/' + cover.path} width="48" height="48" loading="lazy" alt="" /> : <span class="track-cover-placeholder" aria-hidden="true">—</span>}</span>}
        <div class="track-description"><span class="track-title">{track.title}</span>{project && <a data-project={project.id} href={`/projects/${project.slug}/`}>{project.title}</a>}<span class="track-tags">{[...track.genres, ...track.emotions].join(' · ')}</span></div>
      </div>
      {peaks && track.audioAssetId ? <div class="track-wave" data-waveform data-track-id={track.id} data-track-title={track.title} role="slider" tabindex="0" aria-label={`Seek ${track.title}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext={`0:00 of ${formatTrackTime(track.duration)}`}>
        <svg viewBox={`0 0 ${waveformWidth} 40`} preserveAspectRatio="none" aria-hidden="true">
          <g class="wave-bars-unplayed">{peaks.map((peak, k) => {
            const height = Math.max(3, peak * 36);
            return <rect x={k * 4} y={(40 - height) / 2} width="2" height={height} rx="1" />;
          })}</g>
          <g class="wave-bars-played" data-wave-played>{peaks.map((peak, k) => {
            const height = Math.max(3, peak * 36);
            return <rect x={k * 4} y={(40 - height) / 2} width="2" height={height} rx="1" />;
          })}</g>
        </svg>
      </div> : <div class="track-wave track-wave--pending" aria-label="Waveform pending"><span>Waveform pending</span></div>}
      <span class="track-duration">{formatTrackTime(track.duration)}</span>
      <div class="track-play-slot">{track.audioAssetId ? <button class="icon-button track-play-button" data-play-track={track.id} aria-label={`Play ${track.title}`}><span data-track-play-icon><Icon name="play" /></span><span data-track-pause-icon hidden><Icon name="pause" /></span></button> : <span class="track-cell-placeholder" aria-label="Audio forthcoming">—</span>}</div>
      <div class="track-platform-slot">{Object.entries(platforms).length ? Object.entries(platforms).map(([name, url]) => <a class="track-platform" href={url} target="_blank" rel="noreferrer" aria-label={`${name in track.platformOverrides ? 'Track' : 'Album'} on ${name === 'appleMusic' ? 'Apple Music' : name} — ${track.title}`}>{name === 'appleMusic' ? 'Apple Music' : name.charAt(0).toUpperCase() + name.slice(1)} <span class="streaming-link-icon"><Icon name="arrowUpRight" size={14} /></span></a>) : <span class="track-cell-placeholder" aria-label="No streaming platform">—</span>}</div>
    </div>
  })}
  {!tracks.length && <p class="empty-state">The soundtrack will appear here when tracks are available.</p>}
</div>
