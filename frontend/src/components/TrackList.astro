---
import {content,asset} from '../lib/content/data';import {projectForTrack,platformLinks} from '../lib/content/selectors';import Icon from './Icon.astro';import type {Track} from '../../../contracts/content';
interface Props {tracks:Track[]; compact?:boolean}
const {tracks,compact=false}=Astro.props;
---
<div class:list={['track-list',{compact}]}>
 {tracks.map((track,i)=>{const project=projectForTrack(content,track.id);const cover=asset(project?.memberships.music?.coverAssetId);const platforms=project?platformLinks(track,project):{};return <div class="track-row" data-track-row={track.id} data-genres={track.genres.join('|')} data-emotions={track.emotions.join('|')}>
  <span class="track-number">{String(i+1).padStart(2,'0')}</span>
  {cover&&<img src={'/'+cover.path.replace('.webp','-480.webp')} width="48" height="48" loading="lazy" alt=""/>}
  <div class="track-description"><span class="track-title">{track.title}</span>{project&&<a data-project={project.id} href={`/projects/${project.slug}/`}>{project.title}</a>}<span class="track-tags">{[...track.genres,...track.emotions].join(' · ')}</span></div>
  <div class="track-wave" aria-label={track.peaks?'Waveform':'Audio not yet available'}>{track.peaks?<svg viewBox="0 0 200 36" preserveAspectRatio="none" aria-hidden="true">{track.peaks.map((n,k)=><line x1={k*200/track.peaks!.length} x2={k*200/track.peaks!.length} y1={18-n*17} y2={18+n*17} stroke="currentColor" stroke-width="2"/>)}</svg>:<span class="wave-empty"></span>}</div>
  <span class="track-duration">{track.duration?`${Math.floor(track.duration/60)}:${String(Math.floor(track.duration%60)).padStart(2,'0')}`:'—'}</span>
  {track.audioAssetId?<button class="icon-button" data-play-track={track.id} aria-label={`Play ${track.title}`}><Icon name="play"/></button>:<span class="audio-unavailable">Audio forthcoming</span>}
  {Object.entries(platforms).map(([name,url])=><a class="track-platform" href={url} target="_blank" rel="noreferrer" aria-label={`${name in track.platformOverrides?'Track':'Album'} on ${name==='appleMusic'?'Apple Music':name} — ${track.title}`}>{name==='appleMusic'?'Apple Music':name.charAt(0).toUpperCase()+name.slice(1)} ↗</a>)}
 </div>})}
 {!tracks.length&&<p class="empty-state">The soundtrack will appear here when tracks are available.</p>}
</div>
