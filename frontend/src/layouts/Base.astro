---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../styles/site.css'; // One ordered cascade on initial load and client navigation.
import MediaSlot from '../components/MediaSlot.astro';
import Header from '../components/Header.astro';
import Dialogs from '../components/Dialogs.astro';
import Player from '../components/Player.astro';
import ProjectTemplates from '../components/ProjectTemplates.astro';
import DraftPreviewBanner from '../components/DraftPreviewBanner.astro';
import { content as activeContent } from '../lib/content/data';
import type { Manifest } from '../../../contracts/content';
import { siteConfig, type Section, type Theme } from '../config/site.config';
interface Props {
  title?: string;
  section?: Section;
  theme?: Theme;
  description?: string;
  content?: Manifest
}
const { title, section = 'home', theme = 'dark', content = activeContent, description = content.site.description } = Astro.props;
const draftPreview = Astro.locals.draftPreview ?? (import.meta.env.PIANISSIMO_PREVIEW_BUILD === '1' ? { cmsUrl: '/admin' } : undefined);
const publicationBuild = import.meta.env.PIANISSIMO_PUBLICATION_BUILD === '1';
const robots = publicationBuild && !draftPreview ? 'index, follow' : 'noindex, nofollow';
---
<!doctype html>
<html
  lang="en"
  data-theme={theme}
  data-section={section}
  data-about-mode={siteConfig.about.themeMode}
  data-about-default={siteConfig.about.defaultTheme}
  data-draft-preview={draftPreview ? 'true' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === 'light' ? '#F3F0EA' : '#141414'} />
    <meta property="og:title" content={title ? `${title} — Pianissimo Production` : content.site.title} />
    <meta property="og:description" content={description} />
    <title>{title ? `${title} — Pianissimo Production` : 'Pianissimo Production — Sebastian Greim'}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline>
      .js .scene-logo .logo-label { opacity: 0; visibility: hidden }
      @media (prefers-reduced-motion: reduce) {
        .js .scene-logo .logo-label { opacity: 1; visibility: visible }
      }
    </style>
    <script is:inline>window.addEventListener('popstate', function(e) { const id = e.state?.ppModal; const modal = document.querySelector('#project-dialog'); if (modal?.open || (typeof id === 'string' && /^[a-z0-9-]+$/.test(id) && document.querySelector('template[data-project-template="' + id + '"]'))) { e.stopImmediatePropagation(); window.dispatchEvent(new CustomEvent('pianissimo:modal-pop', { detail: e.state })); } }, true);</script>
    <ClientRouter fallback="swap" />
    <script is:inline>document.documentElement.classList.add('js'); if (location.hash === '#about') { const r = document.documentElement; const m = r.dataset.aboutMode; const t = m === 'follow-section' ? (history.state?.aboutContext === 'directing' ? 'light' : r.dataset.aboutDefault) : m; r.dataset.theme = t || 'dark'; r.dataset.aboutTheme = t || 'dark' }</script>
    <script is:inline type="application/json" id="site-content" set:html={JSON.stringify(content).replace(/</g, '\\u003c')} />
  </head>
  <body>
    {section !== 'home' && <div hidden data-hero-parking><MediaSlot name="hero" content={content} /></div>}
    <Header section={section} content={content} />
    <main id="content"><slot /></main>
    <footer class="site-footer"><div class="footer-wordmark">PIANISSIMO <span>PRODUCTION</span></div><div><span>© {new Date().getFullYear()} Sebastian Greim</span><a href="/legal/">Legal Notice</a><a href="/privacy/">Privacy Policy</a><a href="https://www.gleb-digital.de/" target="_blank" rel="noreferrer">Web development by Gleb Medvedovskyy ↗</a><button data-consent-settings>Cookie Settings</button><span class="portfolio-label">Portfolio</span></div></footer>
    <Dialogs content={content} />
    <Player />
    <ProjectTemplates context={section === 'directing' ? 'directing' : 'music'} content={content} />
    {draftPreview && <DraftPreviewBanner cmsUrl={draftPreview.cmsUrl} />}
    <script>import '../lib/app';</script>
  </body>
</html>
