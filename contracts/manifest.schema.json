  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "prototype",
        "release",
        "test"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "audio",
              "video"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^media\\/[a-zA-Z0-9/_-]+\\.(webp|jpg|jpeg|png|mp3|wav|ogg|mp4|webm)$"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
