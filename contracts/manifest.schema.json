          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "alt": {
            "type": "string"
          },
          "crop": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "approved",
              "temporary",
              "test"
            ]
          },
          "credit": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "type",
          "path",
          "alt",
          "crop",
          "origin",
          "source",
          "state"
        ],
        "additionalProperties": false
      }
    },
