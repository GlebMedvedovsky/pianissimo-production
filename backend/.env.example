APP_NAME="Pianissimo CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pianissimo
DB_USERNAME=pianissimo
DB_PASSWORD=
DB_ROOT_PASSWORD=
SESSION_DRIVER=file
SESSION_COOKIE=pianissimo_cms_session
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
CMS_MANIFEST=/var/www/content/manifest.json
CMS_SCHEMA=/var/www/contracts/manifest.schema.json
CMS_MEDIA_ROOT=/var/www/media
CMS_MANAGED_MEDIA_ROOT=/var/www/managed-media
CMS_MEDIA_MAX_KB=512000
CMS_PREVIEW_TTL_MINUTES=15
CMS_PREVIEW_FRONTEND_URL=http://127.0.0.1:4321
CMS_PREVIEW_FRONTEND_INTERNAL_URL=http://host.docker.internal:4321
CMS_PUBLISHER_API_TOKEN=
CMS_GITHUB_REPOSITORY=
CMS_GITHUB_REF=
CMS_PRODUCTION_WORKFLOW=pianissimo-production-publisher.yml
CMS_PREVIEW_WORKFLOW=pianissimo-preview-builder.yml
CMS_GITHUB_TOKEN=
CMS_PRODUCTION_INCOMING_ROOT=/var/www/storage/app/private/production-incoming
CMS_STATIC_RELEASE_ROOT=/var/www/releases/static
