APP_NAME="Pianissimo CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.pianissimo-production.de
APP_LOCALE=de
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=10.35.46.89
DB_PORT=3306
DB_DATABASE=k248550_pianissimo_cms
DB_USERNAME=k248550_pianissimo_cms

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=pianissimo_cms_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
# Contact delivery is intentionally not production-ready until Netcup's real
# mail transport values below are supplied. Production preflight rejects log.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Pianissimo Production"
CONTACT_RECIPIENT=sebastian@pianissimo-production.de
CONTACT_ALLOWED_ORIGIN=https://pianissimo-production.de
CONTACT_MINIMUM_FILL_SECONDS=2

CMS_ALLOWED_HOSTS=admin.pianissimo-production.de
# Leave empty unless Netcup supplies an exact proxy IP or CIDR.
CMS_TRUSTED_PROXIES=
CMS_PUBLIC_SITE_URL=https://pianissimo-production.de
# Replace only at deployment time with the exact lowercase 40-character production commit SHA.
CMS_SOURCE_REVISION=<exact-40-character-production-commit-sha>
CMS_PUBLICATION_DRIVER=package
CMS_PREVIEW_DRIVER=package
CMS_PREVIEW_TTL_MINUTES=15
# Backward-compatible fallback only. Keep the explicit limits below authoritative.
CMS_MEDIA_MAX_KB=65536
# Absolute application ceiling. Increase only after storage/runtime review.
CMS_MEDIA_APPLICATION_MAX_KB=65536
# Ordinary browser/Livewire upload ceiling; must fit measured PHP/FastCGI limits.
CMS_MEDIA_UPLOAD_MAX_KB=65536
# Controlled SFTP-import ceiling; choose the real value after the live timing check.
CMS_MEDIA_IMPORT_MAX_KB=65536

# Generate a high-entropy value of at least 32 non-whitespace characters.
CMS_PUBLISHER_API_TOKEN=
# Required by the package Draft Preview builder. Use an Actions:write-only token.
CMS_GITHUB_REPOSITORY=
CMS_GITHUB_REF=
CMS_PRODUCTION_WORKFLOW=pianissimo-production-publisher.yml
CMS_PREVIEW_WORKFLOW=pianissimo-preview-builder.yml
CMS_GITHUB_TOKEN=

CMS_SCHEMA=/pianissimo-production.de/private/config/manifest.schema.json
CMS_ACTIVE_MANIFEST=/pianissimo-production.de/private/config/manifest.json
CMS_MEDIA_ROOT=/pianissimo-production.de/private/storage/media
CMS_MANAGED_MEDIA_ROOT=/pianissimo-production.de/private/storage/media/managed
CMS_MEDIA_ORIGINALS_ROOT=/pianissimo-production.de/private/storage/media/originals
CMS_MEDIA_INCOMING_ROOT=/pianissimo-production.de/private/incoming/media
CMS_PRIVATE_MEDIA_ROOT=/pianissimo-production.de/private/storage/media/prepared
CMS_PUBLICATION_PACKAGE_ROOT=/pianissimo-production.de/private/packages/production
CMS_FRONTEND_APPLY_STATE=/pianissimo-production.de/private/runtime/frontend-apply
CMS_PREVIEW_STORAGE_ROOT=/pianissimo-production.de/private/runtime/draft-previews
CMS_PREVIEW_PACKAGE_ROOT=/pianissimo-production.de/private/packages/preview
CMS_PREVIEW_INCOMING_ROOT=/pianissimo-production.de/private/incoming/preview
CMS_PREVIEW_RESULT_ROOT=/pianissimo-production.de/private/runtime/preview-results
CMS_PRODUCTION_INCOMING_ROOT=/pianissimo-production.de/private/incoming/production
CMS_STATIC_RELEASE_ROOT=/pianissimo-production.de/releases/static
CMS_PUBLIC_SITE_ROOT=/pianissimo-production.de/httpdocs
